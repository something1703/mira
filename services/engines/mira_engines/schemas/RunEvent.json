{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^run_[a-z0-9]{6,64}$"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "run_started",
        "node_started",
        "node_waiting",
        "node_done",
        "node_cached",
        "node_failed",
        "node_skipped",
        "node_audited",
        "run_finished"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "traceId": {
      "type": "string",
      "pattern": "^trc_[a-z0-9]{6,64}$"
    }
  },
  "required": [
    "runId",
    "type",
    "at",
    "traceId"
  ]
}
