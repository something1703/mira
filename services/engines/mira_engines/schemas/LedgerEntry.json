{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^led_[a-z0-9]{6,64}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "reserve",
        "commit",
        "release"
      ]
    },
    "feature": {
      "type": "string"
    },
    "units": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "runId": {
      "type": "string",
      "pattern": "^run_[a-z0-9]{6,64}$"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^ses_[a-z0-9]{6,64}$"
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "kind",
    "feature",
    "units",
    "runId",
    "nodeId",
    "sessionId",
    "at"
  ]
}
