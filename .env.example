# MIRA environment. Copy to .env.local for `pnpm dev`. `pnpm dev:mock` needs none of this.
# Validated at start-up by packages/schemas/src/env.ts; a missing live value fails fast by name.
# In Cloud Run, secrets come from Secret Manager, never from this file.

# mock | live
MIRA_MODE=live
LOG_LEVEL=info

# --- YouCam (server-side only; never NEXT_PUBLIC_) ---
YOUCAM_API_KEY=
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com
# Webhook signing secret from the YouCam API console (starts with whsec_).
YOUCAM_WEBHOOK_SECRET=

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=asia-south1
GCS_BUCKET_TEMP=
# Set only to point live code at a local Firestore emulator.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Models (docs/AGENT_RUNTIME.md §2, decision D17) ---
# Gemini 3 Flash for both jobs: $0.50 in / $3 out per million tokens, a third of Gemini 3.5 Flash.
# If `pnpm eval:agent` drops below 95%, switch MIRA_MODEL_MAIN to gemini-3.5-flash; no code change.
# vertex-anthropic | vertex-google | anthropic-direct
MIRA_MODEL_PROVIDER=vertex-google
MIRA_MODEL_MAIN=gemini-3-flash-preview
MIRA_MODEL_SMALL=gemini-3-flash-preview
# Gemini 3 Flash is served from the global endpoint.
VERTEX_LOCATION=global
# Only for MIRA_MODEL_PROVIDER=anthropic-direct.
# ANTHROPIC_API_KEY=

# --- Sessions ---
# 32+ random bytes, e.g. `openssl rand -base64 48`.
MIRA_SESSION_SECRET=

# --- Unit caps (product choices for the demo; docs/DECISIONS.md) ---
MIRA_NODE_UNIT_CAP=60
MIRA_RUN_UNIT_CAP=120
MIRA_SESSION_UNIT_CAP=200
MIRA_K_ANON_MIN=20

# --- MIRA MCP server (phase 10): comma-separated name:token pairs ---
# MIRA_MCP_TOKENS=

# --- Browser-visible (allowlist in packages/schemas/src/env.ts; never secrets) ---
NEXT_PUBLIC_MIRA_MODE=live
