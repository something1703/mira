{
  "name": "@mira/agent",
  "version": "0.0.0",
  "private": true,
  "description": "mira-agent: Agent loop, tools, structured output, number injection, claim linter",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsx ../../scripts/build-service.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.94",
    "@ai-sdk/google-vertex": "5.0.129",
    "@mira/fixtures": "workspace:*",
    "@mira/runtime": "workspace:*",
    "@mira/schemas": "workspace:*",
    "@mira/youcam-client": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ai": "7.0.159",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
