{
  "name": "@mira/mira-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "mira-mcp: MIRA's own MCP server for external agents (phase 10)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsx ../../scripts/build-service.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mira/runtime": "workspace:*",
    "@mira/schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
